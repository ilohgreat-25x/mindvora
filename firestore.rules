rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function owns(doc) {
      return isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Read-only lookup of another user's doc (for name/avatar checks).
    function canViewUser(userId) {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(userId));
    }

    // A brand-new profile may not start out premium, verified, rich or admin.
    function safeNewUser(d) {
      return !d.keys().hasAny(['role', 'isAdmin', 'admin', 'wallet', 'balance', 'banned', 'disabled',
                               'isVerified', 'premiumRef', 'premiumSince', 'verifiedSince', 'referralCount'])
        && (!('isPremium' in d) || d.isPremium == false)
        && (!('plan' in d) || d.plan == 'free')
        && (!('earnings' in d) || d.earnings == 0)
        && (!('tips' in d) || d.tips == 0);
    }

    // ── users ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSelf(userId) && safeNewUser(request.resource.data);
      // FIX: `'x' in request.resource.data` checks the WHOLE resulting doc, so
      // once the server wrote e.g. `earnings`, every later self-update (name,
      // avatar, bio…) was denied. Only block changes to protected fields.
      allow update: if isSelf(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'isAdmin', 'admin', 'wallet', 'balance', 'earnings', 'banned',
          'disabled', 'disabledAt', 'disabledReason', 'referralCount',
          // Paid features — only the backend (Firebase Admin) may grant these now.
          'isPremium', 'plan', 'premiumRef', 'premiumProvider', 'premiumSince', 'premiumActivatedCrypto',
          'isVerified', 'verifiedSince', 'verifiedRef', 'tips'
        ]);
      allow delete: if false;
    }

    // ── sparks (posts) ─────────────────────────────────────────────────────
    match /sparks/{sparkId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'avatar', 'text', 'image', 'imageUrl', 'video',
          'likes', 'likedBy', 'comments', 'reposts', 'type', 'tags',
          'category', 'poll', 'giftCount', 'createdAt', 'editedAt',
          'scheduledAt', 'mentionUsers', 'location', 'privacy', 'pinned'
        ]);
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
    }

    // ── comments ───────────────────────────────────────────────────────────
    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
    }

    // ── follows ────────────────────────────────────────────────────────────
    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
    }

    // ── dms (private messages) ─────────────────────────────────────────────
    match /dms/{docId} {
      allow read: if isSignedIn()
        && (resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid
            || resource.data.participants != null
              && request.auth.uid in resource.data.participants);
      allow create: if isSignedIn()
        && (request.resource.data.fromUid == request.auth.uid
            || request.resource.data.toUid == request.auth.uid
            || request.resource.data.participants != null
              && request.auth.uid in request.resource.data.participants);
      allow update, delete: if false;
    }

    // ── calls ──────────────────────────────────────────────────────────────
    match /calls/{docId} {
      allow read: if isSignedIn()
        && (resource.data.callerId == request.auth.uid
            || resource.data.calleeId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.calleeId != request.auth.uid;
      allow update: if isSignedIn()
        && (resource.data.callerId == request.auth.uid
            || resource.data.calleeId == request.auth.uid);
      allow delete: if isSignedIn()
        && (resource.data.callerId == request.auth.uid
            || resource.data.calleeId == request.auth.uid);

      match /{candidateSub}/{candidateId} {
        function isCallParticipant() {
          let call = get(/databases/$(database)/documents/calls/$(callId)).data;
          return call.callerId == request.auth.uid || call.calleeId == request.auth.uid;
        }
        allow read, create: if isSignedIn() && isCallParticipant();
        allow update, delete: if false;
      }
    }

    // ── notifications ──────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read, update: if isSignedIn()
        && resource.data.toUid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.toUid != request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.toUid == request.auth.uid;
    }

    // ── presence ───────────────────────────────────────────────────────────
    match /presence/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSelf(userId);
      allow delete: if isSelf(userId);
    }

    // ── push_queue / security_logs / security_alerts ───────────────────────
    match /push_queue/{docId} { allow read, write: if false; }
    match /security_logs/{docId} { allow read, write: if false; }
    match /security_alerts/{docId} { allow read, write: if false; }

    // ── content that is visible to all signed-in users but not writable ───
    match /ads/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }
    match /app_settings/{docId} { allow read: if isSignedIn(); allow write: if false; }
    match /gifts/{docId} {
      allow read: if isSignedIn();
      allow create: if false; // gifts are recorded by the backend after payment
      allow update, delete: if false;
    }
    match /withdrawals/{docId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    match /payment_verifications/{docId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth.token.admin == true;
      allow update, delete: if false;
    }

    // ── transactional docs: writers are server-only, owners may read ──────
    match /topups/{docId} {
      allow create: if false; // top-ups are recorded by the backend after payment
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    match /purchases/{docId} {
      allow create: if isSignedIn() && request.resource.data.buyerId == request.auth.uid;
      allow read: if isSignedIn()
        && (resource.data.buyerId == request.auth.uid
            || resource.data.sellerId == request.auth.uid);
      allow update, delete: if false;
    }
    match /crypto_payments/{docId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update: if false; // crypto orders now live in crypto_orders (server-only)
      allow delete: if false;
    }
    match /marketplace/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.sellerId == request.auth.uid;
    }
    match /digital_products/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.sellerId == request.auth.uid;
    }
    match /paid_events/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }
    match /support_tickets/{docId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isSignedIn()
        && (resource.data.uid == request.auth.uid || request.auth.token.admin == true);
      allow update: if request.auth.token.admin == true;
      allow delete: if false;
    }
    match /reports/{docId} {
      allow create: if isSignedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read: if request.auth.token.admin == true;
      allow update, delete: if false;
    }
    match /scheduled_posts/{docId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }
    match /groups/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }
    match /stories/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(49, 'h');
      // Owner can edit; any signed-in viewer may ONLY add themselves to seenBy (was owner-only → errors for viewers).
      allow update: if isSignedIn() && (resource.data.uid == request.auth.uid
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy'])
            && request.resource.data.seenBy.toSet().difference(resource.data.seenBy.toSet()).hasOnly([request.auth.uid])));
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }
    match /newsletters/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }
    match /referrals/{docId} {
      allow read: if isSignedIn() && (resource.data.newUserId == request.auth.uid || resource.data.referrerId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
    match /creator_subs/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
    match /live_streams/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
