rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function owns(doc) {
      return isSignedIn() && resource.data.uid == request.auth.uid;
    }
    // Read-only lookup of another user's doc (for name/avatar checks).
    function canViewUser(userId) {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(userId));
    }
    // The app owner (admin). Must be signed in with the verified owner email.
    // MOVED: this used to sit inside `match /admin_events`, so it only existed there.
    function isOwnerAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'ilohgreat25@gmail.com'
        && request.auth.token.email_verified == true;
    }
    // Referral system is ON unless the admin switched it OFF (same default as the app: no doc = ON).
    function referralEnabled() {
      return !exists(/databases/$(database)/documents/app_settings/referral)
        || get(/databases/$(database)/documents/app_settings/referral).data.get('enabled', true) != false;
    }
    // A brand-new profile may not start out premium, verified, rich or admin.
    function safeNewUser(d) {
      return !d.keys().hasAny(['role', 'isAdmin', 'admin', 'wallet', 'balance', 'banned', 'disabled',
                               'isVerified', 'premiumRef', 'premiumSince', 'verifiedSince', 'referralCount'])
        && (!('isPremium' in d) || d.isPremium == false)
        && (!('plan' in d) || d.plan == 'free')
        && (!('earnings' in d) || d.earnings == 0)
        && (!('tips' in d) || d.tips == 0);
    }
    // ── users ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSelf(userId) && safeNewUser(request.resource.data);
      // Only block changes to protected fields (diff-based, so later self-updates still work).
      allow update: if isSelf(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'isAdmin', 'admin', 'wallet', 'balance', 'earnings', 'banned',
          'disabled', 'disabledAt', 'disabledReason', 'referralCount',
          // Paid features — only the backend (Firebase Admin) may grant these.
          'isPremium', 'plan', 'premiumRef', 'premiumProvider', 'premiumSince', 'premiumActivatedCrypto',
          'isVerified', 'verifiedSince', 'verifiedRef', 'tips'
        ]);
      allow delete: if false;
    }
    // ── sparks (posts) ─────────────────────────────────────────────────────
    match /sparks/{sparkId} {
      // Matches what the app writes (authorId, mediaUrl, mediaType, sound, …). Older posts may use uid.
      function sparkOwner(d) { return d.get('authorId', null) == request.auth.uid || d.get('uid', null) == request.auth.uid; }
      allow read: if isSignedIn();
      allow create: if isSignedIn() && sparkOwner(request.resource.data);
      // Owner edits anything; everyone else may only touch engagement counters/lists.
      allow update: if isSignedIn() && (sparkOwner(resource.data)
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'likes', 'saved', 'commentCount', 'reposts', 'viewCount', 'tags', 'reactions', 'poll', 'giftCount', 'shares']));
      allow delete: if isSignedIn() && sparkOwner(resource.data);
    }
    // ── comments ───────────────────────────────────────────────────────────
    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
    }
    // ── follows ────────────────────────────────────────────────────────────
    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
    }
    // ── dms (private messages) ─────────────────────────────────────────────
    // doc id = the two uids sorted and joined with "_", fields `members`, `lastMsg`,
    // per-user flags (pin_/muted_/archived_/locked_/cleared_/deleted_/unread_<uid>),
    // and a `messages` subcollection with `fromId`.
    function dmMember(dmId) {
      return isSignedIn() && request.auth.uid in dmId.split('_');
    }
    // Fails OPEN: only a real `blockedUsers` list on the user doc that contains the other uid blocks.
    function hasBlocked(a, b) {
      return exists(/databases/$(database)/documents/users/$(a))
        && get(/databases/$(database)/documents/users/$(a)).data.get('blockedUsers', []) is list
        && get(/databases/$(database)/documents/users/$(a)).data.get('blockedUsers', []).hasAny([b]);
    }
    function dmBlocked(dmId) {
      return hasBlocked(dmId.split('_')[0], dmId.split('_')[1])
        || hasBlocked(dmId.split('_')[1], dmId.split('_')[0]);
    }
    match /dms/{dmId} {
      allow get: if dmMember(dmId);
      allow list: if isSignedIn() && request.auth.uid in resource.data.members;
      allow create, update: if dmMember(dmId)
        && request.resource.data.members.size() == 2
        && request.resource.data.members.hasAll(dmId.split('_'));
      allow delete: if false;
      match /messages/{msgId} {
        allow read: if dmMember(dmId);
        allow create: if dmMember(dmId)
          && request.resource.data.fromId == request.auth.uid
          && !dmBlocked(dmId);
        allow update: if dmMember(dmId)
          && ((resource.data.fromId == request.auth.uid && request.resource.data.fromId == request.auth.uid)
              || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']));
        allow delete: if dmMember(dmId) && resource.data.fromId == request.auth.uid;
      }
    }
    // ── calls ──────────────────────────────────────────────────────────────
    match /calls/{docId} {
      allow read: if isSignedIn()
        && (resource.data.callerId == request.auth.uid
            || resource.data.calleeId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.calleeId != request.auth.uid;
      allow update: if isSignedIn()
        && (resource.data.callerId == request.auth.uid
            || resource.data.calleeId == request.auth.uid);
      allow delete: if isSignedIn()
        && (resource.data.callerId == request.auth.uid
            || resource.data.calleeId == request.auth.uid);
      match /{candidateSub}/{candidateId} {
        function isCallParticipant() {
          let call = get(/databases/$(database)/documents/calls/$(docId)).data;
          return call.callerId == request.auth.uid || call.calleeId == request.auth.uid;
        }
        allow read, create: if isSignedIn() && isCallParticipant();
        allow update, delete: if false;
      }
    }
    // ── notifications ──────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read, update: if isSignedIn()
        && resource.data.toUid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.toUid != request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.toUid == request.auth.uid;
    }
    // ── user_interests (personalised feed profile) ─────────────────────────
    // Each user's private taste profile. Only that user can read or write it.
    match /user_interests/{userId} {
      allow read, create, update, delete: if isSelf(userId);
    }
    // ── presence ───────────────────────────────────────────────────────────
    match /presence/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSelf(userId);
      allow delete: if isSelf(userId);
    }
    // ── push_queue / security_logs / security_alerts ───────────────────────
    match /push_queue/{docId} { allow read, write: if false; }
    match /security_logs/{docId} { allow read, write: if false; }
    match /security_alerts/{docId} { allow read, write: if false; }
    // ── content that is visible to all signed-in users but not writable ───
    match /ads/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }
    // Live ad activity for the owner's admin panel (written only by the server).
    match /admin_events/{docId} {
      allow read: if isOwnerAdmin();
      allow write: if false;
    }
    // ── app_settings ───────────────────────────────────────────────────────
    // MOVED out of admin_events (it was nested inside it, so the path was wrong and
    // nobody — not even the admin — could reach app_settings/referral).
    // Every signed-in user can READ it, so the app's onSnapshot() listener notifies
    // all users in real time when the admin flips the switch. Only the admin can WRITE.
    match /app_settings/{docId} {
      allow read: if isSignedIn();
      allow create, update: if docId == 'referral'
        && isOwnerAdmin()
        && request.resource.data.enabled is bool;
      allow delete: if false;
    }
    match /withdrawals/{docId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    match /payment_verifications/{docId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth.token.admin == true;
      allow update, delete: if false;
    }
    // ── transactional docs: writers are server-only, owners may read ──────
    match /topups/{docId} {
      allow create: if false; // top-ups are recorded by the backend after payment
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    match /purchases/{docId} {
      allow create: if isSignedIn() && request.resource.data.buyerId == request.auth.uid;
      allow read: if isSignedIn()
        && (resource.data.buyerId == request.auth.uid
            || resource.data.sellerId == request.auth.uid);
      allow update, delete: if false;
    }
    match /crypto_payments/{docId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update: if false; // crypto orders now live in crypto_orders (server-only)
      allow delete: if false;
    }
    match /marketplace/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.sellerId == request.auth.uid;
    }
    match /digital_products/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.sellerId == request.auth.uid;
    }
    match /paid_events/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }
    match /support_tickets/{docId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isSignedIn()
        && (resource.data.uid == request.auth.uid || request.auth.token.admin == true);
      allow update: if request.auth.token.admin == true;
      allow delete: if false;
    }
    match /reports/{docId} {
      allow create: if isSignedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read: if request.auth.token.admin == true;
      allow update, delete: if false;
    }
    // The app saves the owner as authorId (older docs: uid).
    match /scheduled_posts/{docId} {
      allow create: if isSignedIn() && (request.resource.data.get('authorId', '') == request.auth.uid
                                        || request.resource.data.get('uid', '') == request.auth.uid);
      allow read, update, delete: if isSignedIn() && (resource.data.get('authorId', '') == request.auth.uid
                                                      || resource.data.get('uid', '') == request.auth.uid);
    }
    match /groups/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }
    match /stories/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(49, 'h');
      // Owner can edit; any signed-in viewer may ONLY add themselves to seenBy.
      allow update: if isSignedIn() && (resource.data.uid == request.auth.uid
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy'])
            && request.resource.data.seenBy.toSet().difference(resource.data.seenBy.toSet()).hasOnly([request.auth.uid])));
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }
    match /newsletters/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }
    // ── referrals ──────────────────────────────────────────────────────────
    // A referral can only be recorded while the admin has the referral system ON,
    // only by the new user themselves, and nobody can refer themselves.
    match /referrals/{docId} {
      allow read: if isSignedIn() && (resource.data.newUserId == request.auth.uid
                                      || resource.data.referrerId == request.auth.uid
                                      || isOwnerAdmin());
      allow create: if isSignedIn()
        && referralEnabled()
        && request.resource.data.newUserId == request.auth.uid
        && request.resource.data.referrerId != request.auth.uid;
      allow update, delete: if false;
    }
    match /creator_subs/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
    // Go Live saves the host as hostId (older docs: uid).
    match /live_streams/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.resource.data.get('hostId', '') == request.auth.uid
                                        || request.resource.data.get('uid', '') == request.auth.uid);
      // Host edits/deletes; viewers may only bump the viewer count.
      allow update: if isSignedIn() && (resource.data.get('hostId', '') == request.auth.uid
                                        || resource.data.get('uid', '') == request.auth.uid
                                        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers']));
      allow delete: if isSignedIn() && (resource.data.get('hostId', '') == request.auth.uid
                                        || resource.data.get('uid', '') == request.auth.uid);
      // WebRTC connection signals between host and viewers, and the live chat.
      match /signals/{sigId} {
        allow read, create, update: if isSignedIn();
        allow delete: if isSignedIn() && get(/databases/$(database)/documents/live_streams/$(docId)).data.get('hostId', '') == request.auth.uid;
        match /{ice}/{iceId} {   // host_ice / viewer_ice network candidates
          allow read, create: if isSignedIn();
        }
      }
      match /{sub}/{subId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && sub in ['chat', 'viewers', 'reactions', 'answers', 'candidates'];
      }
    }
  }
}
